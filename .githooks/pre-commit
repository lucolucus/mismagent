#!/bin/sh
# Keep the derived packagings (codex/, pi/) aligned with their source (plugins/).
# Enable once per clone: git config core.hooksPath .githooks
set -e
if git diff --cached --quiet -- plugins tools/generate-codex.py tools/generate-pi.py; then
  exit 0
fi
echo "pre-commit: plugins/ (or a generator) changed -> regenerating codex/ and pi/"
python3 tools/generate-codex.py >/dev/null
python3 tools/generate-pi.py >/dev/null
git add codex pi
